# ── Vercel → Settings → Environment Variables 에 그대로 등록하세요 ──
# 로컬에서 실행할 때는 이 파일을 .env.local 로 복사해서 값을 채우면 됩니다.

# ① Apps Script 웹앱 배포 주소 (.../exec 로 끝나야 함)
#    [배포] → [새 배포] → 유형 '웹 앱' → 실행: 나 / 액세스: 모든 사용자
GAS_URL=https://script.google.com/macros/s/AKfycb.../exec

# ② Apps Script 메뉴 [🎮 길드정산] → [🔑 웹 API 토큰] 에서 발급한 값
#    이 값은 서버에만 저장되고 브라우저로 절대 내려가지 않습니다.
GAS_TOKEN=

# ③ 관리자 PIN — 이걸 아는 사람만 등록·분배·지급을 할 수 있습니다.
#    숫자 4자리보다는 6자리 이상을 권장합니다.
ADMIN_PIN=

# ④ 관리자 로그인 쿠키 서명용 비밀키. 아무 긴 임의 문자열이면 됩니다.
#    예) openssl rand -base64 32
SESSION_SECRET=

# ⑤ (선택) 마스터관리자 PIN — 개발자용. v10.0
#    관리자가 할 수 있는 것 전부 + 앱 이름 변경 + 관리자 PIN 원격 교체.
#    ADMIN_PIN 과 반드시 다른 값이어야 합니다 (같으면 마스터로 인정하지 않습니다).
#    비워두면 마스터 기능만 잠기고 나머지는 그대로 동작합니다.
MASTER_PIN=
