      danger: 1,
      inputs: [{ key: 'url', label: '웹훅 주소', placeholder: 'https://discord.com/api/webhooks/...' }],
      run: function (ss, params) {
        const url = String(params.url || '').trim();
        if (url && url.indexOf('https://') !== 0) {
          return { ok: false, msg: '웹훅 주소는 https:// 로 시작해야 합니다.' };
