        return { ok: true, msg: url ? '✅ 디스코드 알림을 켰습니다.' : '✅ 디스코드 알림을 껐습니다.' };
      }
    },

    seasonEnd: {
      name: '🏁 시즌 종료',
      desc: '지금까지의 기록을 [시즌N] 시트로 보존하고 잔액·아이템을 초기화합니다.',
      danger: 3,
      confirm: '시즌종료',
      inputs: [],
      run: function (ss) {
