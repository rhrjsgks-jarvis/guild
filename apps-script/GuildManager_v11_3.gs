  sheet.getRange('F1').setNote('부분 지급: 금액을 입력한 뒤 지급✓를 체크하면 그 금액만 지급됩니다.\n비워두고 체크하면 분배전 전액이 지급됩니다.\n지급 후 이 칸은 자동으로 비워집니다.');

  const n = members.length;
