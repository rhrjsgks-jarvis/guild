      name: '🔁 참여횟수 재계산',
      desc: '등록 이력을 다시 세어 참여횟수를 맞춥니다. 다이아 잔액은 건드리지 않습니다.',
      danger: 1,
      inputs: [],
      run: function (ss) {
        const n = _recalcAllParticipationCounts(ss);
