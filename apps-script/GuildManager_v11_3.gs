      }
    },

    tidy: {
      name: '📐 시트 정돈',
      desc: '시트 순서와 행 높이, 이름 서식을 표준으로 되돌립니다.',
      danger: 1,
      inputs: [],
      run: function (ss) {
        _reorderSheets(ss);
