  sheet.getRange(totalRow, 3).setFormula(`=SUM(C2:C${totalRow - 1})`).setFontWeight('bold').setNumberFormat('#,##0').setHorizontalAlignment('right');
  sheet.setRowHeight(totalRow, 34);
